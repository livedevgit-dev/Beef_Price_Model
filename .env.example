# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)

# USDA AMS Datamart (수입육 USDA 시세)
USDA_API_KEY=

# 다음 카페 로그인 (미트미플 B2B 크롤링 — collect_cafe_b2b.py)
DAUM_ID=
DAUM_PW=

# EKAPE 축산물품질평가원 OpenAPI (한우 경락가격·도축두수)
# 발급: https://www.data.go.kr/data/15058822/openapi.do
EKAPE_API_KEY=

# KAMIS Open API (한우 도/소매가 — 선택)
# 공공데이터포털이 아닌 KAMIS 사이트에서 별도 신청
# 발급: https://www.kamis.or.kr/customer/reference/openapi_list.do
# 비워 두면 collect_kamis_hanwoo.py 는 자동 skip (EKAPE만으로 대시보드 동작)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=

# FRED API (미국 거시지표 — 옥수수·WTI·Food PPI / collect_macro_fred.py)
# 발급: https://fredaccount.stlouisfed.org/apikeys
# 비워 두면 collect_macro_fred.py 는 자동 skip
FRED_API_KEY=

# 한국은행 ECOS Open API (국내 거시지표 — 기준금리·CPI·PPI·심리지수 / collect_macro_ecos.py)
# 발급: https://ecos.bok.or.kr/api/  (인증키 신청)
# 비워 두면 collect_macro_ecos.py 는 자동 skip
ECOS_API_KEY=

# USDA FAS Export Sales (미국 소고기 국가별 주간 수출 — 덤핑 조기경보 / collect_fas_export_sales.py)
# 발급(무료): FAS Open Data Portal https://apps.fas.usda.gov/opendatawebv2/ (가입 → API Keys)
# 비워 두면 collect_fas_export_sales.py 는 자동 skip
FAS_API_KEY=

# USDA NASS QuickStats (미국 Cattle on Feed 사육두수 — 공급 4~6개월 선행 / collect_cattle_on_feed.py)
# 발급(무료): https://quickstats.nass.usda.gov/api (이메일 등록)
# 비워 두면 collect_cattle_on_feed.py 는 자동 skip
NASS_API_KEY=

# 기상청 API 허브 — 종관기상관측(ASOS) 일자료 (국내 기후지표 — 기온·강수 / collect_macro_kma.py)
# 발급: https://apihub.kma.go.kr (회원가입 → '종관기상관측 일자료' API 활용신청)
# 값: API 허브 authKey 를 그대로 입력
# 비워 두면 collect_macro_kma.py 는 자동 skip
KMA_API_KEY=
